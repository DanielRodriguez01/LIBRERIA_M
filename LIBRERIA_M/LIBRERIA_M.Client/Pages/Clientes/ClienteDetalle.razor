@page "/clientes/nuevo"
@page "/clientes/detalle/{IdCliente:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using LIBRERIA_M.Client.Models.Clientes
@using LIBRERIA_M.Client.Services
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation
@inject ClienteService ClienteService
@inject IJSRuntime JS

<PageTitle>
    @(EsNuevo ? "Crear Cliente" : "Detalle Cliente")
</PageTitle>

<div class="page-container">

    <!-- CABECERA SUPERIOR -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn-secundario" @onclick="Volver">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver al listado
        </button>

        @if (!EsNuevo)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-info text-white fw-bold btn-sm px-3" @onclick="HabilitarEdicion">
                    <i class="fa-solid fa-pen-to-square me-1"></i> EDITAR CLIENTE
                </button>
                <button type="button" class="btn btn-outline-danger fw-bold btn-sm px-3" @onclick="ConfirmarDesactivacion">
                    <i class="fa-solid fa-user-xmark me-1"></i> DESACTIVAR CLIENTE
                </button>
            </div>
        }
    </div>

    <!-- MENSAJE DE ERROR O ÉXITO -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            <strong>Atención:</strong> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando información del cliente...</p>
        </div>
    }
    else if (EsNuevo || modoEdicion)
    {
        <!-- VISTA FORMULARIO: CREACIÓN O EDICIÓN COMPLETA -->
        <div class="card shadow-sm border-0 p-4">
            <h4 class="fw-bold mb-4">@(EsNuevo ? "Nuevo Cliente" : "Editar Cliente")</h4>
            <EditForm Model="cliente" OnValidSubmit="GuardarCliente">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre *</label>
                        <InputText class="form-control" @bind-Value="cliente.Nombre" placeholder="Ej. Daniel" />
                        <ValidationMessage For="@(() => cliente.Nombre)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Apellido *</label>
                        <InputText class="form-control" @bind-Value="cliente.Apellido" placeholder="Ej. Rodriguez" />
                        <ValidationMessage For="@(() => cliente.Apellido)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">DNI *</label>
                        <InputText class="form-control" @bind-Value="cliente.DNI" placeholder="Sin puntos ni espacios" />
                        <ValidationMessage For="@(() => cliente.DNI)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Teléfono</label>
                        <InputText class="form-control" @bind-Value="cliente.Telefono" placeholder="Ej. 99994444" />
                        <ValidationMessage For="@(() => cliente.Telefono)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Email</label>
                        <InputText class="form-control" @bind-Value="cliente.Email" placeholder="correo@ejemplo.com" />
                        <ValidationMessage For="@(() => cliente.Email)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Dirección</label>
                        <InputText class="form-control" @bind-Value="cliente.Direccion" placeholder="Ej. Av. Mayo 111" />
                        <ValidationMessage For="@(() => cliente.Direccion)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tipo de Cliente</label>
                        <InputSelect class="form-select" @bind-Value="cliente.TipoCliente" @bind-Value:after="OnTipoClienteChanged">
                            <option value="Normal">Normal</option>
                            <option value="Particular">Particular</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Descuento (%)</label>
                        <InputNumber class="form-control" @bind-Value="cliente.PorcentajeDescuento" min="0" max="100" disabled="@(!EsClienteParticular)" />
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="button" class="btn btn-light px-4 me-2 fw-bold" @onclick="CancelarEdicion">
                        CANCELAR
                    </button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        @(EsNuevo ? "GUARDAR CLIENTE" : "GUARDAR CAMBIOS")
                    </button>
                </div>
            </EditForm>
        </div>
    }
    else
    {
        <!-- VISTA DASHBOARD CLIENTE -->
        <div class="row g-3 mb-4">
            <!-- TARJETA IZQUIERDA: INFORMACIÓN DEL CLIENTE -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">INFORMACIÓN DEL CLIENTE</h6>
                    <div class="lh-lg">
                        <div><strong>NOMBRE :</strong> @cliente.Apellido?.ToUpper() @cliente.Nombre?.ToUpper()</div>
                        <div><i class="fa-solid fa-id-card me-2 text-muted"></i><strong>DNI :</strong> @cliente.DNI</div>
                        <div><i class="fa-solid fa-phone me-2 text-muted"></i><strong>TELÉFONO :</strong> @(string.IsNullOrEmpty(cliente.Telefono) ? "-" : cliente.Telefono)</div>
                        <div><i class="fa-solid fa-location-dot me-2 text-muted"></i><strong>DIRECCIÓN :</strong> @(string.IsNullOrEmpty(cliente.Direccion) ? "-" : cliente.Direccion)</div>
                        <div><i class="fa-solid fa-envelope me-2 text-muted"></i><strong>EMAIL :</strong> @(string.IsNullOrEmpty(cliente.Email) ? "-" : cliente.Email)</div>
                        <div><strong>CLIENTE DESDE:</strong> @cliente.FechaAlta.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>

            <!-- TARJETA DERECHA: RESUMEN FINANCIERO -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-3">
                    <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">RESUMEN FINANCIERO</h6>

                    <div class="d-flex align-items-center justify-content-between mb-3 p-2 rounded bg-light">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-success text-white p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fa-solid fa-dollar-sign fs-5"></i>
                            </div>
                            <span class="fw-bold text-secondary">TOTAL COMPRADO</span>
                        </div>
                        <span class="fs-5 fw-bold text-success">$ @resumenCliente.TotalComprado.ToString("N2")</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-3 p-2 rounded bg-light">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-danger text-white p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fa-solid fa-dollar-sign fs-5"></i>
                            </div>
                            <span class="fw-bold text-secondary">SALDO PENDIENTE</span>
                        </div>
                        <span class="fs-5 fw-bold text-danger">$ @resumenCliente.SaldoPendiente.ToString("N2")</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="fw-bold text-secondary">ESTADO ACTUAL:</span>
                        @if (resumenCliente.SaldoPendiente > 0 || resumenCliente.EstadoFinanciero == "CON DEUDA")
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2">CON DEUDA</span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6 px-3 py-2">AL DÍA</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- SECCIÓN INFERIOR: HISTORIAL Y REGISTRO DE PAGO -->
        <div class="row g-3">

            <!-- SECCIÓN PESTAÑAS (TABS) -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm p-3 h-100">

                    <ul class="nav nav-tabs border-bottom-0 mb-3">
                        <li class="nav-item">
                            <button class="nav-link fw-bold @(pestanaActiva == "Compras" ? "active" : "")" @onclick='() => CambiarPestana("Compras")'>
                                HISTORIAL DE COMPRAS
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold @(pestanaActiva == "Pagos" ? "active" : "")" @onclick='() => CambiarPestana("Pagos")'>
                                PAGOS REALIZADOS
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold @(pestanaActiva == "Pedidos" ? "active" : "")" @onclick='() => CambiarPestana("Pedidos")'>
                                PEDIDOS
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold @(pestanaActiva == "Notas" ? "active" : "")" @onclick='() => CambiarPestana("Notas")'>
                                NOTAS
                            </button>
                        </li>
                    </ul>

                    @if (pestanaActiva == "Compras")
                    {
                        @if (!historialCompras.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="fa-solid fa-receipt fa-2x mb-2 d-block"></i>
                                El cliente aún no registra compras en el sistema.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr class="table-light">
                                            <th class="text-nowrap">FECHA</th>
                                            <th class="text-nowrap">Nº DE FACTURA</th>
                                            <th class="text-nowrap text-end">TOTAL</th>
                                            <th class="text-nowrap text-end">PAGADO</th>
                                            <th class="text-nowrap text-end">SALDO</th>
                                            <th class="text-nowrap text-center">ESTADO</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in listaComprasPaginada)
                                        {
                                            <tr>
                                                <td class="text-nowrap">@item.FechaVenta.ToString("dd/MM/yyyy")</td>
                                                <td class="text-nowrap">@item.NumeroFactura</td>
                                                <td class="text-nowrap text-end">$ @item.TotalVenta.ToString("N2")</td>
                                                <td class="text-nowrap text-end text-success fw-bold">$ @item.TotalPagado.ToString("N2")</td>
                                                <td class="text-nowrap text-end text-danger fw-bold">$ @item.SaldoPendiente.ToString("N2")</td>
                                                <td class="text-nowrap text-center">
                                                    @if (item.SaldoPendiente <= 0 || item.Estado == "PAGADO")
                                                    {
                                                        <span class="badge bg-success">PAGADO</span>
                                                    }
                                                    else if (item.TotalPagado > 0)
                                                    {
                                                        <span class="badge bg-warning text-dark">PARCIAL</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">PENDIENTE</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- PIE DE TABLA CON PAGINACIÓN PARA COMPRAS -->
                            <div class="pie-tabla border-top pt-2">
                                <div class="info-registros">
                                    Mostrando @(((paginaCompras - 1) * elementosPorPagina) + 1) a @Math.Min(paginaCompras * elementosPorPagina, totalCompras) de @totalCompras compras
                                </div>
                                <div class="paginacion">
                                    <button class="btn-pagina" @onclick="() => CambiarPaginaCompras(paginaCompras - 1)" disabled="@(paginaCompras == 1)">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>

                                    @foreach (var p in PaginasVisiblesCompras)
                                    {
                                        var numPagina = p;
                                        <button class="btn-pagina @(paginaCompras == numPagina ? "activa" : "")" @onclick="() => CambiarPaginaCompras(numPagina)">
                                            @numPagina
                                        </button>
                                    }

                                    <button class="btn-pagina" @onclick="() => CambiarPaginaCompras(paginaCompras + 1)" disabled="@(paginaCompras == totalPaginasCompras)">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else if (pestanaActiva == "Pagos")
                    {
                        @if (!historialPagos.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="fa-solid fa-money-bill-transfer fa-2x mb-2 d-block"></i>
                                No hay pagos registrados para este cliente.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr class="table-light">
                                            <th class="text-nowrap">FECHA</th>
                                            <th class="text-nowrap">Nº FACTURA</th>
                                            <th class="text-nowrap">MÉTODO</th>
                                            <th class="text-nowrap text-end">MONTO</th>
                                            <th class="text-nowrap">OBSERVACIONES</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pago in listaPagosPaginada)
                                        {
                                            <tr>
                                                <td class="text-nowrap">@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-nowrap">@(string.IsNullOrWhiteSpace(pago.NumeroFactura) ? "Pago Global" : pago.NumeroFactura)</td>
                                                <td class="text-nowrap"><span class="badge bg-info text-dark">@pago.MetodoPago</span></td>
                                                <td class="text-nowrap text-end text-success fw-bold">$ @pago.Monto.ToString("N2")</td>
                                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(pago.Observaciones) ? "-" : pago.Observaciones)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- PIE DE TABLA CON PAGINACIÓN PARA PAGOS -->
                            <div class="pie-tabla border-top pt-2">
                                <div class="info-registros">
                                    Mostrando @(((paginaPagos - 1) * elementosPorPagina) + 1) a @Math.Min(paginaPagos * elementosPorPagina, totalPagos) de @totalPagos pagos
                                </div>
                                <div class="paginacion">
                                    <button class="btn-pagina" @onclick="() => CambiarPaginaPagos(paginaPagos - 1)" disabled="@(paginaPagos == 1)">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>

                                    @foreach (var p in PaginasVisiblesPagos)
                                    {
                                        var numPagina = p;
                                        <button class="btn-pagina @(paginaPagos == numPagina ? "activa" : "")" @onclick="() => CambiarPaginaPagos(numPagina)">
                                            @numPagina
                                        </button>
                                    }

                                    <button class="btn-pagina" @onclick="() => CambiarPaginaPagos(paginaPagos + 1)" disabled="@(paginaPagos == totalPaginasPagos)">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else if (pestanaActiva == "Pedidos")
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                            No existen pedidos pendientes.
                        </div>
                    }
                    else if (pestanaActiva == "Notas")
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fa-solid fa-note-sticky fa-2x mb-2 d-block"></i>
                            Sin observaciones anotadas.
                        </div>
                    }

                </div>
            </div>

            <!-- SECCIÓN REGISTRAR PAGO DE CLIENTE (replicada de Registrar Pago a Proveedor) -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="fa-solid fa-hand-holding-dollar text-info me-2"></i>Registrar Pago de Cliente
                    </h6>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Venta / Factura a Abonar <span class="text-danger">*</span></label>
                        <select class="form-select" value="@idVentaSeleccionada" @onchange="OnVentaSeleccionadaChanged">
                            <option value="0">-- Seleccionar Factura Pendiente --</option>
                            @foreach (var v in historialCompras.Where(x => x.SaldoPendiente > 0))
                            {
                                <option value="@v.IdVenta">
                                    @(string.IsNullOrEmpty(v.NumeroFactura) ? $"Venta #{v.IdVenta}" : v.NumeroFactura) - (Saldo: $@v.SaldoPendiente.ToString("N2"))
                                </option>
                            }
                        </select>
                        @if (!historialCompras.Any(x => x.SaldoPendiente > 0))
                        {
                            <small class="text-success d-block mt-1">
                                <i class="fa-solid fa-circle-check me-1"></i> El cliente no registra deudas pendientes.
                            </small>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Monto a Abonar ($)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" @bind="montoPago" placeholder="0.00" min="0" step="0.01" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Medio de Pago</label>
                        <select class="form-select" @bind="metodoPago">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Debito">Tarjeta de Débito</option>
                            <option value="Credito">Tarjeta de Crédito</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Detalle / Concepto / Referencia</label>
                        <textarea class="form-control" rows="3" @bind="observacionesPago" placeholder="Pago a cuenta, cancelación de factura X..."></textarea>
                    </div>

                    <button class="btn btn-info text-white w-100 fw-bold py-2 mt-2"
                            @onclick="RegistrarPago"
                            disabled="@(procesandoPago || idVentaSeleccionada == 0)">
                        @if (procesandoPago)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-check me-1"></i>
                            <span>Confirmar Pago</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    }

</div>

@code {
    [Parameter]
    public int? IdCliente { get; set; }

    private ClienteDto cliente = new()
    {
        TipoCliente = "Normal",
        Estado = true,
        PorcentajeDescuento = 0
    };

    private ClienteResumenDto resumenCliente = new();
    private List<ClienteHistorialCompraDto> historialCompras = new();
    private List<ClienteHistorialPagoDto> historialPagos = new();

    private bool cargando = false;
    private bool modoEdicion = false;
    private bool procesandoPago = false;
    private string? mensajeError = null;
    private string? mensajeExito = null;
    private string pestanaActiva = "Compras";

    // Formulario de Pago
    private int idVentaSeleccionada = 0;
    private decimal montoPago = 0.00m;
    private string metodoPago = "Efectivo";
    private string? observacionesPago = null;

    // PAGINACIÓN EN CLIENTE
    private int elementosPorPagina = 5;
    private int paginaCompras = 1;
    private int paginaPagos = 1;

    private int totalCompras => historialCompras.Count;
    private int totalPaginasCompras => (int)Math.Ceiling((double)totalCompras / elementosPorPagina);
    private IEnumerable<ClienteHistorialCompraDto> listaComprasPaginada =>
        historialCompras.Skip((paginaCompras - 1) * elementosPorPagina).Take(elementosPorPagina);

    private int totalPagos => historialPagos.Count;
    private int totalPaginasPagos => (int)Math.Ceiling((double)totalPagos / elementosPorPagina);
    private IEnumerable<ClienteHistorialPagoDto> listaPagosPaginada =>
        historialPagos.Skip((paginaPagos - 1) * elementosPorPagina).Take(elementosPorPagina);

    private List<int> PaginasVisiblesCompras => ObtenerPaginasVisibles(paginaCompras, totalPaginasCompras);
    private List<int> PaginasVisiblesPagos => ObtenerPaginasVisibles(paginaPagos, totalPaginasPagos);

    private bool EsNuevo => !IdCliente.HasValue;

    // El descuento solo se puede definir para clientes "Particular"
    private bool EsClienteParticular => cliente.TipoCliente == "Particular";

    protected override async Task OnInitializedAsync()
    {
        if (IdCliente.HasValue)
        {
            await CargarClienteExistente();
        }
    }

    private async Task CargarClienteExistente()
    {
        if (!IdCliente.HasValue) return;

        cargando = true;
        mensajeError = null;

        try
        {
            var c = await ClienteService.ObtenerPorIdAsync(IdCliente.Value);
            if (c != null)
            {
                cliente = c;

                var resumenTask = ClienteService.ObtenerResumenClienteAsync(IdCliente.Value);
                var comprasTask = ClienteService.ObtenerHistorialComprasAsync(IdCliente.Value);
                var pagosTask = ClienteService.ObtenerHistorialPagosAsync(IdCliente.Value);

                await Task.WhenAll(resumenTask, comprasTask, pagosTask);

                resumenCliente = await resumenTask ?? new ClienteResumenDto { IdCliente = IdCliente.Value };
                historialCompras = await comprasTask ?? new List<ClienteHistorialCompraDto>();
                historialPagos = await pagosTask ?? new List<ClienteHistorialPagoDto>();

                paginaCompras = 1;
                paginaPagos = 1;

                // Preselecciona la primera venta con saldo pendiente (igual que en Proveedores)
                var ventaConDeuda = historialCompras.FirstOrDefault(v => v.SaldoPendiente > 0);
                if (ventaConDeuda != null)
                {
                    idVentaSeleccionada = ventaConDeuda.IdVenta;
                    montoPago = ventaConDeuda.SaldoPendiente;
                }
                else
                {
                    idVentaSeleccionada = 0;
                    montoPago = 0.00m;
                }
            }
            else
            {
                Navigation.NavigateTo("/clientes");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar cliente: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarPestana(string nombrePestana)
    {
        pestanaActiva = nombrePestana;
    }

    private void CambiarPaginaCompras(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= totalPaginasCompras)
        {
            paginaCompras = nuevaPagina;
        }
    }

    private void CambiarPaginaPagos(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= totalPaginasPagos)
        {
            paginaPagos = nuevaPagina;
        }
    }

    private List<int> ObtenerPaginasVisibles(int paginaActual, int totalPaginas)
    {
        var paginas = new List<int>();
        if (totalPaginas <= 0) return paginas;

        int inicio = Math.Max(1, paginaActual - 1);
        int fin = Math.Min(totalPaginas, paginaActual + 1);

        if (paginaActual == 1)
        {
            fin = Math.Min(totalPaginas, 3);
        }
        else if (paginaActual == totalPaginas)
        {
            inicio = Math.Max(1, totalPaginas - 2);
        }

        for (int i = inicio; i <= fin; i++)
        {
            paginas.Add(i);
        }

        return paginas;
    }

    private void HabilitarEdicion()
    {
        modoEdicion = true;
    }

    private async Task CancelarEdicion()
    {
        if (EsNuevo)
        {
            Volver();
        }
        else
        {
            modoEdicion = false;
            await CargarClienteExistente();
        }
    }

    // Si el cliente deja de ser "Particular", el descuento vuelve a 0
    private void OnTipoClienteChanged()
    {
        if (!EsClienteParticular)
        {
            cliente.PorcentajeDescuento = 0;
        }
    }

    private async Task GuardarCliente()
    {
        mensajeError = null;

        // Los clientes "Normal" no tienen descuento
        if (!EsClienteParticular)
        {
            cliente.PorcentajeDescuento = 0;
        }

        try
        {
            if (EsNuevo)
            {
                await ClienteService.CrearClienteAsync(cliente);
            }
            else
            {
                await ClienteService.ActualizarClienteAsync(cliente);
            }

            Navigation.NavigateTo("/clientes");
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task ConfirmarDesactivacion()
    {
        if (!IdCliente.HasValue) return;

        bool confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Está seguro de desactivar al cliente {cliente.Apellido}, {cliente.Nombre}?");

        if (confirmado)
        {
            try
            {
                await ClienteService.DesactivarClienteAsync(cliente.IdCliente);
                Navigation.NavigateTo("/clientes");
            }
            catch (Exception ex)
            {
                mensajeError = ex.Message;
            }
        }
    }

    // Al elegir una factura del desplegable, el monto se autocompleta con su saldo pendiente
    private void OnVentaSeleccionadaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idVenta))
        {
            idVentaSeleccionada = idVenta;
            var venta = historialCompras.FirstOrDefault(v => v.IdVenta == idVentaSeleccionada);
            montoPago = venta != null ? venta.SaldoPendiente : 0.00m;
        }
    }

    private async Task RegistrarPago()
    {
        if (!IdCliente.HasValue) return;

        if (idVentaSeleccionada <= 0)
        {
            mensajeError = "Por favor, seleccione una factura con saldo pendiente.";
            return;
        }

        if (montoPago <= 0)
        {
            mensajeError = "Ingrese un monto a pagar mayor a cero.";
            return;
        }

        procesandoPago = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var pagoDto = new RegistrarPagoClienteDto
            {
                IdCliente = IdCliente.Value,
                IdVenta = idVentaSeleccionada,
                Monto = montoPago,
                TipoPago = metodoPago,
                Observaciones = observacionesPago,
                FechaPago = DateTime.Now
            };

            await ClienteService.RegistrarPagoClienteAsync(pagoDto);

            mensajeExito = $"Pago de $ {montoPago:N2} registrado correctamente.";
            LimpiarFormularioPago();
            await CargarClienteExistente();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al registrar el pago: {ex.Message}";
        }
        finally
        {
            procesandoPago = false;
        }
    }

    private void LimpiarFormularioPago()
    {
        idVentaSeleccionada = 0;
        montoPago = 0.00m;
        metodoPago = "Efectivo";
        observacionesPago = null;
    }

    private void Volver()
    {
        Navigation.NavigateTo("/clientes");
    }
}
