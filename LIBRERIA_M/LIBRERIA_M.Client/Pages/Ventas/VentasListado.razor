@page "/ventas"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using global::LIBRERIA_M.Client.Models.Ventas
@using global::LIBRERIA_M.Client.Services
@using System.Globalization

@inject VentaService VentaService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Ventas - Librería</PageTitle>

<div class="page-container">

    <h2 class="titulo-modulo">
        VENTAS (LISTADO)
    </h2>

    <div class="card-principal">

        <div class="card-secundaria">

            <!-- ========================= -->
            <!-- Barra Superior -->
            <!-- ========================= -->

            <div class="toolbar">

                <input class="input-busqueda"
                       type="text"
                       placeholder="🔍 Buscar por N° Comprobante, Cliente o DNI..."
                       @bind="textoBusqueda"
                       @bind:after="ReiniciarPaginaBusqueda"
                       @bind:event="oninput" />

                <button class="btn-principal"
                        @onclick="NuevaVenta">
                    + Nueva Venta
                </button>

            </div>

            <!-- ========================= -->
            <!-- Filtros -->
            <!-- ========================= -->

            <div class="filtros">

                <span class="titulo-filtro">
                    Filtrar por estado:
                </span>

                <div class="grupo-filtros">

                    <button class="@ObtenerClaseFiltro("Todos")"
                            @onclick='() => CambiarFiltroEstado("Todos")'>
                        Todos
                    </button>

                    <button class="@ObtenerClaseFiltro("PAGADO")"
                            @onclick='() => CambiarFiltroEstado("PAGADO")'>
                        Pagadas
                    </button>

                    <button class="@ObtenerClaseFiltro("PENDIENTE")"
                            @onclick='() => CambiarFiltroEstado("PENDIENTE")'>
                        Pendientes
                    </button>

                    <button class="@ObtenerClaseFiltro("PARCIAL")"
                            @onclick='() => CambiarFiltroEstado("PARCIAL")'>
                        Parciales
                    </button>

                </div>

            </div>

            <!-- ========================= -->
            <!-- Tabla -->
            <!-- ========================= -->

            <div class="tabla-container">

                <table class="tabla-stock">

                    <thead>

                        <tr>

                            <th>N°Comprobante</th>

                            <th class="text-center">Fecha</th>

                            <th>Cliente</th>

                            <th class="text-center">Documento</th>

                            <th class="text-right">Total</th>

                            <th class="text-right">Saldo</th>

                            <th class="text-center">Estado</th>

                            <th class="text-center">Acciones</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (cargando)
                        {
                            <tr>
                                <td colspan="8" class="sin-registros">
                                    Cargando ventas...
                                </td>
                            </tr>
                        }
                        else if (VentasFiltradas.Any())
                        {
                            @foreach (var v in VentasFiltradas)
                            {
                                <tr>

                                    <td>
                                        <strong>@v.NumeroFactura</strong>
                                    </td>

                                    <td class="text-center">
                                        @v.FechaVenta.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @v.ClienteNombre
                                    </td>

                                    <td class="text-center">
                                        @(string.IsNullOrWhiteSpace(v.ClienteDocumento) ? "-" : v.ClienteDocumento)
                                    </td>

                                    <td class="text-right">
                                        @v.TotalVenta.ToString("C", formatoMoneda)
                                    </td>

                                    <td class="text-right">
                                        @v.SaldoPendiente.ToString("C", formatoMoneda)
                                    </td>

                                    <td class="text-center">

                                        <span class="@ObtenerClaseBadgeEstado(v.Estado)">
                                            @(string.IsNullOrWhiteSpace(v.Estado) ? "Sin estado" : v.Estado)
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <div class="acciones-cell">
                                            <button class="btn-editar"
                                                    title="Ver Detalle"
                                                    @onclick="() => VerDetalle(v.IdVenta)">

                                                <i class="fa-solid fa-eye"></i>

                                            </button>

                                            @if (v.Estado?.Trim().ToUpper() == "PENDIENTE" || v.Estado?.Trim().ToUpper() == "PARCIAL")
                                            {
                                                <button class="btn-editar"
                                                        title="Registrar Pago"
                                                        @onclick="() => RegistrarPago(v.IdVenta)">

                                                    <i class="fa-solid fa-pen"></i>

                                                </button>
                                            }
                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8" class="sin-registros">

                                    No se encontraron registros de ventas.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- ========================= -->
            <!-- Paginación -->
            <!-- ========================= -->
            @if (TotalPaginas > 1)
            {
                <div class="paginacion">

                    <!-- Página anterior -->

                    <button class="btn-pagina flecha"
                            title="Página anterior"
                            @onclick="() => CambiarPagina(paginaActual - 1)"
                            disabled="@(paginaActual == 1)">

                        <i class="fa-solid fa-chevron-left"></i>

                    </button>


                    <!-- Primera página -->
                    @if (DebeMostrarPrimeraPagina)
                    {
                        <button class="@ObtenerClasePagina(1)"
                                @onclick="() => CambiarPagina(1)">
                            1
                        </button>
                    }


                    <!-- Puntos suspensivos iniciales -->
                    @if (DebeMostrarPuntosIniciales)
                    {
                        <span class="puntos-paginacion">
                            ...
                        </span>
                    }


                    <!-- Páginas cercanas a la actual -->
                    @foreach (var pagina in PaginasVisibles)
                    {
                        <button class="@ObtenerClasePagina(pagina)"
                                @onclick="() => CambiarPagina(pagina)">

                            @pagina

                        </button>
                    }


                    <!-- Puntos suspensivos finales -->
                    @if (DebeMostrarPuntosFinales)
                    {
                        <span class="puntos-paginacion">
                            ...
                        </span>
                    }


                    <!-- Última página -->
                    @if (DebeMostrarUltimaPagina)
                    {
                        <button class="@ObtenerClasePagina(TotalPaginas)"
                                @onclick="() => CambiarPagina(TotalPaginas)">

                            @TotalPaginas

                        </button>
                    }


                    <!-- Página siguiente -->

                    <button class="btn-pagina flecha"
                            title="Página siguiente"
                            @onclick="() => CambiarPagina(paginaActual + 1)"
                            disabled="@(paginaActual == TotalPaginas)">

                        <i class="fa-solid fa-chevron-right"></i>

                    </button>

                </div>
            }

        </div>

    </div>

</div>

@code {

    private List<VentaListadoDto> ventas = new();

    private bool cargando = true;

    private string? textoBusqueda = "";

    private string estadoSeleccionado = "Todos";

    private int paginaActual = 1;

    private const int registrosPorPagina = 5;

    private readonly CultureInfo formatoMoneda = new CultureInfo("es-AR")
    {
        NumberFormat = new NumberFormatInfo
        {
            CurrencySymbol = "$",
            CurrencyPositivePattern = 0, // Muestra el signo $ adelante ($ 3.000,00)
            CurrencyNegativePattern = 8,
            CurrencyGroupSeparator = ".",
            CurrencyDecimalSeparator = ","
        }
    };


    // ==========================================
    // CARGA INICIAL
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        await CargarVentas();
    }

    private async Task CargarVentas()
    {
        cargando = true;
        try
        {
            var resultado = await VentaService.ListarVentas(null, null, null, null);
            ventas = resultado ?? new List<VentaListadoDto>();
            AjustarPaginaActual();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar ventas: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }


    // ==========================================
    // FILTRADO BASE
    // ==========================================

    private IEnumerable<VentaListadoDto> VentasFiltradasBase =>
        ventas
            .Where(v =>
                string.IsNullOrWhiteSpace(textoBusqueda)
                || (v.NumeroFactura?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)
                || (v.ClienteNombre?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)
                || (v.ClienteDocumento?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(v =>
            {
                if (string.IsNullOrWhiteSpace(estadoSeleccionado) || estadoSeleccionado == "Todos")
                    return true;

                return EsEstadoCoincidente(v, estadoSeleccionado);
            });

    private bool EsEstadoCoincidente(VentaListadoDto v, string filtro)
    {
        var estadoLimpio = v.Estado?.Trim().ToUpper() ?? "";
        var filtroLimpio = filtro.Trim().ToUpper();

        return estadoLimpio == filtroLimpio;
    }


    // ==========================================
    // VENTAS DE LA PÁGINA ACTUAL
    // ==========================================

    private IEnumerable<VentaListadoDto> VentasFiltradas =>
        VentasFiltradasBase
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina);


    // ==========================================
    // TOTAL DE PÁGINAS
    // ==========================================

    private int TotalPaginas
    {
        get
        {
            var totalRegistros = VentasFiltradasBase.Count();
            return totalRegistros == 0 ? 1 : (int)Math.Ceiling(totalRegistros / (double)registrosPorPagina);
        }
    }


    // ==========================================
    // CAMBIAR DE PÁGINA
    // ==========================================

    private void CambiarPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas)
            return;

        paginaActual = pagina;
    }


    // ==========================================
    // CAMBIAR FILTRO DE ESTADO
    // ==========================================

    private void CambiarFiltroEstado(string estado)
    {
        estadoSeleccionado = estado;
        paginaActual = 1;
    }


    // ==========================================
    // CLASE DE FILTRO Y BADGE
    // ==========================================

    private string ObtenerClaseFiltro(string estado)
    {
        if (estadoSeleccionado != estado)
            return "btn-filtro";

        return estado switch
        {
            "Todos" => "btn-filtro filtro-todos",
            "PAGADO" => "btn-filtro filtro-pagado",
            "PARCIAL" => "btn-filtro filtro-stockbajo",
            "PENDIENTE" => "btn-filtro filtro-sinstock",
            _ => "btn-filtro"
        };
    }

    private string ObtenerClaseBadgeEstado(string estado)
    {
        if (string.IsNullOrEmpty(estado)) return "";
        var est = estado.ToUpper().Trim();

        return est switch
        {
            "PAGADO" => "estado-disponible",
            "PARCIAL" => "estado-stockbajo",
            "PENDIENTE" => "estado-sinstock",
            _ => ""
        };
    }


    // ==========================================
    // NAVEGACIÓN
    // ==========================================

    private void NuevaVenta()
    {
        Navigation.NavigateTo("/ventas/nueva");
    }

    private void VerDetalle(int idVenta)
    {
        Navigation.NavigateTo($"/ventas/{idVenta}");
    }

    private void RegistrarPago(int idVenta)
    {
        Navigation.NavigateTo($"/ventas/pago-pendiente/{idVenta}");
    }


    // ==========================================
    // REINICIAR PAGINACIÓN AL BUSCAR
    // ==========================================

    private void ReiniciarPaginaBusqueda()
    {
        paginaActual = 1;
    }


    // ==========================================
    // AJUSTAR PÁGINA ACTUAL
    // ==========================================

    private void AjustarPaginaActual()
    {
        if (paginaActual > TotalPaginas)
        {
            paginaActual = TotalPaginas;
        }

        if (paginaActual < 1)
        {
            paginaActual = 1;
        }
    }


    // ==========================================
    // PAGINACIÓN VISUAL
    // ==========================================

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            if (TotalPaginas <= 5)
            {
                return Enumerable.Range(1, TotalPaginas);
            }

            var inicio = Math.Max(2, paginaActual - 1);
            var fin = Math.Min(TotalPaginas - 1, paginaActual + 1);

            if (paginaActual <= 2)
            {
                inicio = 2;
                fin = 4;
            }

            if (paginaActual >= TotalPaginas - 1)
            {
                inicio = TotalPaginas - 3;
                fin = TotalPaginas - 1;
            }

            return Enumerable.Range(inicio, fin - inicio + 1);
        }
    }


    // ==========================================
    // VISIBILIDAD DE BOTONES DE PAGINACIÓN
    // ==========================================

    private bool DebeMostrarPrimeraPagina => TotalPaginas > 5 && !PaginasVisibles.Contains(1);

    private bool DebeMostrarUltimaPagina => TotalPaginas > 5 && !PaginasVisibles.Contains(TotalPaginas);

    private bool DebeMostrarPuntosIniciales => TotalPaginas > 5 && PaginasVisibles.FirstOrDefault() > 2;

    private bool DebeMostrarPuntosFinales => TotalPaginas > 5 && PaginasVisibles.LastOrDefault() < TotalPaginas - 1;

    private string ObtenerClasePagina(int pagina)
    {
        return paginaActual == pagina ? "btn-pagina activa" : "btn-pagina";
    }

}