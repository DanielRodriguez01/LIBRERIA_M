@page "/stock/nuevo"
@page "/stock/editar/{IdProducto:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using LIBRERIA_M.Client.Models
@using LIBRERIA_M.Client.Services
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager Navigation
@inject ProductoService ProductoService

<PageTitle>
    @(EsEdicion ? "Editar Producto" : "Nuevo Producto")
</PageTitle>

<div class="page-nuevo-producto">

    <h3 class="titulo-seccion">

        <button class="btn btn-link text-decoration-none btn-volver"
                @onclick="Volver"
                title="Volver al listado de Stock">

            <i class="fa-solid fa-arrow-left"></i>

        </button>

        @(EsEdicion ? "Editar Producto" : "Nuevo Producto")

    </h3>

    <div class="card-formulario">

        <EditForm Model="producto"
                  OnValidSubmit="GuardarProducto">

            <DataAnnotationsValidator />

            <div class="row">

                <!-- ========================= -->
                <!-- Columna Izquierda -->
                <!-- ========================= -->

                <div class="col-md-6">

                    <div class="mb-4">

                        <label class="form-label">
                            Código
                        </label>

                        @if (EsEdicion)
                        {
                            <input class="form-control"
                                   value="@producto.Codigo"
                                   disabled />
                        }
                        else
                        {
                            <input class="form-control"
                                   value="(Automático)"
                                   disabled />
                        }

                        <small class="text-muted">

                            @if (EsEdicion)
                            {
                                <span>
                                    El código del producto no puede modificarse.
                                </span>
                            }
                            else
                            {
                                <span>
                                    El código será generado automáticamente.
                                </span>
                            }

                        </small>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Nombre *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="producto.Nombre" />

                        <ValidationMessage For="@(() => producto.Nombre)" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Stock Actual *
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="producto.StockActual"
                                     min="0"
                                     max="999999" />

                        <ValidationMessage For="@(() => producto.StockActual)" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Stock Mínimo *
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="producto.StockMinimo"
                                     min="0"
                                     max="999999" />

                        <ValidationMessage For="@(() => producto.StockMinimo)" />

                        <small class="text-muted">

                            Ingrese la cantidad mínima de stock.
                            Cuando el stock actual sea igual o menor,
                            el sistema marcará automáticamente el producto
                            como Stock Bajo.

                        </small>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Precio Unitario *
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="producto.PrecioUnitario" />

                        <ValidationMessage For="@(() => producto.PrecioUnitario)" />

                    </div>

                </div>

                <!-- ========================= -->
                <!-- Columna Derecha -->
                <!-- ========================= -->

                <div class="col-md-6">

                    <div class="card-imagen">

                        <h5>Imagen del Producto</h5>

                        @if (!string.IsNullOrEmpty(imagenVistaPrevia))
                        {
                            <img src="@imagenVistaPrevia"
                                 class="imagen-preview"
                                 alt="Vista previa del producto" />
                        }
                        else
                        {
                            <i class="fa-regular fa-image fa-4x icono-imagen"></i>
                        }

                        @* MODIFICACIÓN: Se ha ocultado el input estándar y se usa el label como botón *@
                        <InputFile id="input-imagen"
                                   OnChange="SeleccionarImagen"
                                   accept="image/png,image/jpeg,image/jpg"
                                   class="input-imagen-oculto" />

                        <label for="input-imagen"
                               class="btn-subir">

                            <i class="fa-solid fa-upload"></i>

                            <span>Subir Imagen</span>

                        </label>

                        <small class="texto-imagen">
                            Formatos permitidos: JPG, JPEG o PNG. Máximo 5 MB.
                        </small>

                    </div>

                    <div class="mt-4 mb-4">

                        <label class="form-label">
                            Estado del Stock
                        </label>

                        <div class="mt-2">

                            <span class="@ObtenerClaseEstado()">
                                @EstadoCalculado
                            </span>

                        </div>

                        <small class="text-muted">

                            El estado se calcula automáticamente según
                            el Stock Actual y el Stock Mínimo.

                        </small>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Descripción (Opcional)
                        </label>

                        <InputTextArea class="form-control"
                                       rows="5"
                                       @bind-Value="producto.Descripcion" />

                    </div>

                </div>

            </div>

            <div class="text-end mt-4">

                <button type="button"
                        class="btn-cancelar me-3"
                        @onclick="Volver">

                    Cancelar

                </button>

                <button type="submit"
                        class="btn-confirmar">

                    @(EsEdicion ? "Guardar Cambios" : "Confirmar")

                </button>

            </div>

        </EditForm>

    </div>

</div>

@code
{
    [Parameter]
    public int? IdProducto { get; set; }

    private ProductoDto producto = new()
    {
        StockActual = 0,
        StockMinimo = 5,
        Estado = "Activo",
        CostoPromedio = 0
    };

    private string? imagenVistaPrevia;

    private bool EsEdicion => IdProducto.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (IdProducto.HasValue)
        {
            var productoExistente =
                await ProductoService.ObtenerProductoPorId(IdProducto.Value);

            if (productoExistente == null)
            {
                Navigation.NavigateTo("/stock");
                return;
            }

            producto = productoExistente;

            // ==========================================
            // CARGAR IMAGEN EXISTENTE
            // ==========================================

            if (!string.IsNullOrWhiteSpace(producto.Imagen))
            {
                imagenVistaPrevia = PrepararImagen(producto.Imagen);
            }
        }
    }

    // ==========================================
    // PREPARAR IMAGEN PARA MOSTRAR
    // ==========================================

    private string PrepararImagen(string imagen)
    {
        // Si ya contiene el Data URI completo,
        // no necesitamos modificarlo.

        if (imagen.StartsWith("data:image/",
            StringComparison.OrdinalIgnoreCase))
        {
            return imagen;
        }

        // Si solamente tenemos Base64, usamos JPEG
        // como tipo predeterminado.

        return $"data:image/jpeg;base64,{imagen}";
    }

    // ==========================================
    // SELECCIONAR IMAGEN
    // ==========================================

    private async Task SeleccionarImagen(InputFileChangeEventArgs e)
    {
        var archivo = e.File;

        if (archivo == null)
            return;

        // ==========================================
        // LÍMITE DE 5 MB
        // ==========================================

        const long maximoBytes = 5 * 1024 * 1024;

        if (archivo.Size > maximoBytes)
        {
            Console.WriteLine(
                "La imagen no puede superar los 5 MB.");

            return;
        }

        // ==========================================
        // TIPOS PERMITIDOS
        // ==========================================

        var tiposPermitidos = new[]
        {
            "image/png",
            "image/jpeg",
            "image/jpg"
        };

        if (!tiposPermitidos.Contains(archivo.ContentType))
        {
            Console.WriteLine(
                "El archivo seleccionado no es una imagen válida.");

            return;
        }

        // ==========================================
        // LEER ARCHIVO
        // ==========================================

        using var stream =
            archivo.OpenReadStream(maxAllowedSize: maximoBytes);

        using var memoryStream = new MemoryStream();

        await stream.CopyToAsync(memoryStream);

        var buffer = memoryStream.ToArray();

        // ==========================================
        // CONVERTIR A BASE64
        // ==========================================

        var base64 = Convert.ToBase64String(buffer);

        // ==========================================
        // CREAR DATA URI
        // ==========================================

        imagenVistaPrevia =
            $"data:{archivo.ContentType};base64,{base64}";

        // Guardamos la imagen dentro del DTO
        // para que GuardarProducto la envíe al servidor.

        producto.Imagen = imagenVistaPrevia;
    }

    // ==========================================
    // ESTADO DEL STOCK
    // ==========================================

    private string EstadoCalculado
    {
        get
        {
            if (producto.StockActual == 0)
                return "Sin Stock";

            if (producto.StockActual <= producto.StockMinimo)
                return "Stock Bajo";

            return "Disponible";
        }
    }

    private string ObtenerClaseEstado()
    {
        return EstadoCalculado switch
        {
            "Disponible" => "estado-disponible",
            "Stock Bajo" => "estado-stock-bajo",
            _ => "estado-sin-stock"
        };
    }

    // ==========================================
    // VOLVER
    // ==========================================

    private void Volver()
    {
        Navigation.NavigateTo("/stock");
    }

    // ==========================================
    // GUARDAR PRODUCTO
    // ==========================================

    private async Task GuardarProducto()
    {
        try
        {
            producto.Estado = "Activo";

            if (EsEdicion)
            {
                await ProductoService.ActualizarProducto(producto);
            }
            else
            {
                producto.CostoPromedio = 0;

                await ProductoService.CrearProducto(producto);
            }

            Navigation.NavigateTo("/stock");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}