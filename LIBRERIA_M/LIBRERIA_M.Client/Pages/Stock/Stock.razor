@page "/stock"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using LIBRERIA_M.Client.Models
@using LIBRERIA_M.Client.Services
@using System.Globalization

@inject ProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>Stock - Librería</PageTitle>

<div class="page-container">

    <h2 class="titulo-modulo">
        STOCK (LISTADO)
    </h2>

    <div class="card-principal">

        <div class="card-secundaria">

            <!-- ========================= -->
            <!-- Barra Superior -->
            <!-- ========================= -->

            <div class="toolbar">

                <input class="input-busqueda"
                       type="text"
                       placeholder="🔍 Buscar producto por nombre o código..."
                       @bind="textoBusqueda"
                       @bind:after="ReiniciarPaginaBusqueda"
                       @bind:event="oninput" />

                <button class="btn-principal"
                        @onclick="NuevoProducto">
                    + Nuevo Producto
                </button>

            </div>

            <!-- ========================= -->
            <!-- Filtros -->
            <!-- ========================= -->

            <div class="filtros">

                <span class="titulo-filtro">
                    Filtrar por stock:
                </span>

                <div class="grupo-filtros">

                    <button class="@ObtenerClaseFiltro("Todos")"
                            @onclick='() => CambiarFiltro("Todos")'>
                        Todos
                    </button>

                    <button class="@ObtenerClaseFiltro("StockBajo")"
                            @onclick='() => CambiarFiltro("StockBajo")'>
                        Stock Bajo
                    </button>

                    <button class="@ObtenerClaseFiltro("SinStock")"
                            @onclick='() => CambiarFiltro("SinStock")'>
                        Sin Stock
                    </button>

                </div>

            </div>

            <!-- ========================= -->
            <!-- Tabla -->
            <!-- ========================= -->

            <table class="tabla-stock">

                <thead>

                    <tr>

                        <th class="col-codigo">Código</th>

                        <th class="col-nombre">Nombre</th>

                        <th class="col-stock">Stock</th>

                        <th class="col-estado">Estado</th>

                        <th class="col-precio">Precio</th>

                        <th class="col-acciones">Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @if (ProductosFiltrados.Any())
                    {
                        @foreach (var producto in ProductosFiltrados)
                        {
                            <tr>

                                <td class="col-codigo">
                                    @(string.IsNullOrWhiteSpace(producto.Codigo) ? "-" : producto.Codigo)
                                </td>

                                <td class="col-nombre">
                                    @producto.Nombre
                                </td>

                                <td class="col-stock">

                                    @if (producto.StockBajo)
                                    {
                                        <span class="stock-bajo">
                                            @producto.StockActual
                                        </span>
                                    }
                                    else
                                    {
                                        @producto.StockActual
                                    }

                                </td>

                                <td class="col-estado">

                                    @switch (producto.Estado)
                                    {
                                        case "Disponible":
                                            <span class="estado-disponible">Disponible</span>
                                            break;

                                        case "Stock Bajo":
                                            <span class="estado-stockbajo">Stock Bajo</span>
                                            break;

                                        case "Sin Stock":
                                            <span class="estado-sinstock">Sin Stock</span>
                                            break;

                                        default:
                                            <span>@(string.IsNullOrWhiteSpace(producto.Estado) ? "Sin estado" : producto.Estado)</span>
                                            break;
                                    }

                                </td>

                                <td class="col-precio">

                                    @producto.PrecioUnitario.ToString("C", formatoMoneda)

                                </td>

                                <td class="col-acciones">

                                    <button class="btn-editar"
                                            title="Editar producto"
                                            @onclick="() => EditarProducto(producto.IdProducto)">

                                        <i class="fa-solid fa-pen-to-square"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6" class="sin-registros">

                                No se encontraron productos.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- ========================= -->
            <!-- Paginación -->
            <!-- ========================= -->
            @if (TotalPaginas > 1)
            {
                <div class="paginacion">

                    <!-- Página anterior -->

                    <button class="btn-pagina flecha"
                            title="Página anterior"
                            @onclick="() => CambiarPagina(paginaActual - 1)"
                            disabled="@(paginaActual == 1)">

                        <i class="fa-solid fa-chevron-left"></i>

                    </button>


                    <!-- Primera página -->
                    @if (DebeMostrarPrimeraPagina)
                    {
                        <button class="@ObtenerClasePagina(1)"
                                @onclick="() => CambiarPagina(1)">
                            1
                        </button>
                    }


                    <!-- Puntos suspensivos iniciales -->
                    @if (DebeMostrarPuntosIniciales)
                    {
                        <span class="puntos-paginacion">
                            ...
                        </span>
                    }


                    <!-- Páginas cercanas a la actual -->
                    @foreach (var pagina in PaginasVisibles)
                    {
                        <button class="@ObtenerClasePagina(pagina)"
                                @onclick="() => CambiarPagina(pagina)">

                            @pagina

                        </button>
                    }


                    <!-- Puntos suspensivos finales -->
                    @if (DebeMostrarPuntosFinales)
                    {
                        <span class="puntos-paginacion">
                            ...
                        </span>
                    }


                    <!-- Última página -->
                    @if (DebeMostrarUltimaPagina)
                    {
                        <button class="@ObtenerClasePagina(TotalPaginas)"
                                @onclick="() => CambiarPagina(TotalPaginas)">

                            @TotalPaginas

                        </button>
                    }


                    <!-- Página siguiente -->

                    <button class="btn-pagina flecha"
                            title="Página siguiente"
                            @onclick="() => CambiarPagina(paginaActual + 1)"
                            disabled="@(paginaActual == TotalPaginas)">

                        <i class="fa-solid fa-chevron-right"></i>

                    </button>

                </div>
            }

        </div>

    </div>

</div>

@code {

    private List<ProductoDto> productos = new();

    private string textoBusqueda = "";

    private string filtroStock = "Todos";

    private int paginaActual = 1;

    private const int registrosPorPagina = 5;

    // MODIFICACIÓN: Formato de moneda localizado (Argentina) con punto para miles, coma para decimales y símbolo $ al final.
    private readonly CultureInfo formatoMoneda = new CultureInfo("es-AR")
    {
        NumberFormat = new NumberFormatInfo
        {
            CurrencySymbol = "$",
            CurrencyPositivePattern = 3, // Pattern: n $
            CurrencyNegativePattern = 8, // Pattern: -n $
            CurrencyGroupSeparator = ".",
            CurrencyDecimalSeparator = ","
        }
    };


    // ==========================================
    // CARGA INICIAL
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ProductoService.ObtenerProductos();
        productos = resultado ?? new List<ProductoDto>();

        AjustarPaginaActual();
    }


    // ==========================================
    // FILTRADO BASE
    // ==========================================

    private IEnumerable<ProductoDto> ProductosFiltradosBase =>
        productos
            .Where(p =>
                string.IsNullOrWhiteSpace(textoBusqueda)
                || (p.Nombre?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)
                || (p.Codigo?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(p =>
            {
                switch (filtroStock)
                {
                    case "StockBajo":
                        return p.Estado == "Stock Bajo";

                    case "SinStock":
                        return p.Estado == "Sin Stock";

                    default:
                        return true;
                }
            });


    // ==========================================
    // PRODUCTOS DE LA PÁGINA ACTUAL
    // ==========================================

    private IEnumerable<ProductoDto> ProductosFiltrados =>
        ProductosFiltradosBase
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina);


    // ==========================================
    // TOTAL DE PÁGINAS
    // ==========================================

    private int TotalPaginas
    {
        get
        {
            var totalRegistros = ProductosFiltradosBase.Count();
            return totalRegistros == 0 ? 1 : (int)Math.Ceiling(totalRegistros / (double)registrosPorPagina);
        }
    }


    // ==========================================
    // CAMBIAR DE PÁGINA
    // ==========================================

    private void CambiarPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas)
            return;

        paginaActual = pagina;
    }


    // ==========================================
    // CAMBIAR FILTRO
    // ==========================================

    private void CambiarFiltro(string filtro)
    {
        filtroStock = filtro;
        paginaActual = 1;
    }


    // ==========================================
    // CLASE DE FILTRO
    // ==========================================

    private string ObtenerClaseFiltro(string filtro)
    {
        if (filtroStock != filtro)
            return "btn-filtro";

        return filtro switch
        {
            "Todos" => "btn-filtro filtro-todos",
            "StockBajo" => "btn-filtro filtro-stockbajo",
            "SinStock" => "btn-filtro filtro-sinstock",
            _ => "btn-filtro"
        };
    }


    // ==========================================
    // NAVEGACIÓN
    // ==========================================

    private void NuevoProducto()
    {
        Navigation.NavigateTo("/stock/nuevo");
    }


    private void EditarProducto(int idProducto)
    {
        Navigation.NavigateTo($"/stock/editar/{idProducto}");
    }


    // ==========================================
    // REINICIAR PAGINACIÓN AL BUSCAR
    // ==========================================

    private void ReiniciarPaginaBusqueda()
    {
        paginaActual = 1;
    }


    // ==========================================
    // AJUSTAR PÁGINA ACTUAL
    // ==========================================

    private void AjustarPaginaActual()
    {
        if (paginaActual > TotalPaginas)
        {
            paginaActual = TotalPaginas;
        }

        if (paginaActual < 1)
        {
            paginaActual = 1;
        }
    }


    // ==========================================
    // PAGINACIÓN VISUAL
    // ==========================================

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            if (TotalPaginas <= 5)
            {
                return Enumerable.Range(1, TotalPaginas);
            }

            var inicio = Math.Max(2, paginaActual - 1);
            var fin = Math.Min(TotalPaginas - 1, paginaActual + 1);

            if (paginaActual <= 2)
            {
                inicio = 2;
                fin = 4;
            }

            if (paginaActual >= TotalPaginas - 1)
            {
                inicio = TotalPaginas - 3;
                fin = TotalPaginas - 1;
            }

            return Enumerable.Range(inicio, fin - inicio + 1);
        }
    }


    // ==========================================
    // VISIBILIDAD DE BOTONES DE PAGINACIÓN
    // ==========================================

    private bool DebeMostrarPrimeraPagina => TotalPaginas > 5 && !PaginasVisibles.Contains(1);

    private bool DebeMostrarUltimaPagina => TotalPaginas > 5 && !PaginasVisibles.Contains(TotalPaginas);

    private bool DebeMostrarPuntosIniciales => TotalPaginas > 5 && PaginasVisibles.FirstOrDefault() > 2;

    private bool DebeMostrarPuntosFinales => TotalPaginas > 5 && PaginasVisibles.LastOrDefault() < TotalPaginas - 1;

    private string ObtenerClasePagina(int pagina)
    {
        return paginaActual == pagina ? "btn-pagina activa" : "btn-pagina";
    }

}